# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homestead_db
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# JWT Configuration
JWT_SECRET=your_strong_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Client URL (React frontend)
CLIENT_URL=http://localhost:3000

# ─── Paystack Payment Gateway ────────────────────────────────────────────────
# Get your keys from https://dashboard.paystack.com/#/settings/developers
# Use test keys (sk_test_...) during development, live keys (sk_live_...) in production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
# URL Paystack redirects to after checkout — must match CLIENT_URL/dashboard/payments
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/payments
# Webhook secret — used to verify HMAC-SHA512 webhook signatures from Paystack
# Set this to the same value as PAYSTACK_SECRET_KEY unless you use a separate webhook secret
PAYSTACK_WEBHOOK_SECRET=sk_test_your_paystack_secret_key_here

# ─── Supabase (Google OAuth) ──────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → your project → Settings → API
# The SERVICE ROLE key is server-only — NEVER put it in the frontend .env
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Supabase Storage (apartment images) ─────────────────────────────────────
# Images are uploaded to this public bucket. It is created automatically on
# first upload, so you only need to set this if you want a different name.
# Without Supabase Storage, uploads fall back to server/uploads, which is
# ephemeral on Render and will lose files on every redeploy.
SUPABASE_STORAGE_BUCKET=apartment-images
