VITE_PAYSTACK_PUBLIC_KEY=pk_test_bf320d3c0b2878a436d38f39e6be61c8fcb71529

# ─── API URL ───────────────────────────────────────────────────────────────────
# In development, Vite proxies /api/* to localhost:5000 so this is not needed.
# In production (Vercel), set this to the full Render backend URL.
# Without this, all API calls go to the Vercel origin and return 405.
# VITE_API_URL=https://your-render-app.onrender.com/api

# ─── Supabase (Google OAuth) ──────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → your project → Settings → API
# Only the anon/public key is safe to use in the browser
# Replace the placeholders below with your real Supabase project credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
